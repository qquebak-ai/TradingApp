# Скопируй в .env и поправь под себя. Файл .env в git не попадает.

# Где хранить базу со сделками
TRADINGAPP_DB=data/trading.db

# Адрес и порт дашборда.
# 127.0.0.1 — доступ только с этого компьютера (безопасно по умолчанию).
# 0.0.0.0 — доступ с телефона и других устройств в твоей сети;
# в этом случае обязательно задай TRADINGAPP_TOKEN ниже.
TRADINGAPP_HOST=127.0.0.1
TRADINGAPP_PORT=8420

# Токен доступа к API. Пустое значение = без пароля (только для 127.0.0.1).
# Открывать дашборд с токеном: http://адрес:8420/?token=ТВОЙ_ТОКЕН
TRADINGAPP_TOKEN=

# Живой коннектор MT5 (только Windows, рядом с запущенным терминалом).
# Если терминал уже залогинен, достаточно оставить всё пустым.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_HISTORY_DAYS=3650

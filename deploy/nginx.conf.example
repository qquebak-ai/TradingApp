# Вариант с nginx. Положи в /etc/nginx/sites-available/tradingapp,
# сделай симлинк в sites-enabled, потом:
#   sudo certbot --nginx -d trading.example.com
#   sudo nginx -t && sudo systemctl reload nginx
#
# ВАЖНО: нужен отдельный поддомен, а не подпапка — фронтенд ходит
# за /static и /api от корня сайта.

server {
    listen 80;
    listen [::]:80;
    server_name trading.example.com;
    # certbot заменит этот блок на редирект после выпуска сертификата.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name trading.example.com;

    # Пути подставит certbot.
    ssl_certificate     /etc/letsencrypt/live/trading.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/trading.example.com/privkey.pem;

    # Отчёты MT4/MT5 бывают в несколько мегабайт, а лимит по умолчанию — 1 МБ.
    client_max_body_size 32m;

    # Токен уходит в заголовке Authorization, но адреса всё равно
    # не стоит писать в общий лог дольше необходимого.
    access_log /var/log/nginx/tradingapp.access.log;

    location / {
        proxy_pass http://127.0.0.1:8420;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
